# syntax=docker/dockerfile:1.7
# 前端生产镜像：pnpm 构建 SPA → nginx 承接栈内唯一入口（静态 + /api 与探针反代）。
# TLS/入口由宿主 Caddy 负责（infra/caddy/Caddyfile.example）；/api 在 nginx 反代到 api 容器。
FROM node:22-alpine AS build
ENV CI=1
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
# 依赖层（lockfile 不变则不重装）
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/apps/web/package.json apps/web/package.json
COPY frontend/packages/api-client/package.json packages/api-client/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
# 构建
COPY frontend/apps/web apps/web
COPY frontend/packages/api-client packages/api-client
RUN pnpm --filter web build

FROM nginx:1.27-alpine AS runtime
COPY infra/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
