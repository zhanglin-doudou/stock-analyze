# 生产环境模板：复制为 infra/.env.prod（已在 .gitignore），逐项填写后再部署。
# 禁止把填写后的文件提交到仓库；生产应改由密钥管理/Secret 注入同名的环境变量。

# ── 运行环境 ───────────────────────────────────────────────
STOCK_ENV=prod
STOCK_LOG_LEVEL=INFO

# ── 入口 / TLS ────────────────────────────────────────────
# TLS/域名/证书由**宿主 Caddy** 负责（站点示例见 infra/caddy/Caddyfile.example），
# 编排内不再跑网关容器；web 容器端口只绑 127.0.0.1:8002，80/443 归 Caddy。
# 域名必须已解析到本机，且 80/443 可从公网访问（Caddy 自动签发/续期证书）。
# 镜像 tag（建议 git sha；回滚就是换回旧 tag）
TAG=latest

# ── 数据库（云主机 PostgreSQL:5432，不在 Docker 编排内）────
# 云主机内网 IP/域名；5432 仅对应用主机开放（安全组收紧）。
# 建议启用 TLS：如需 sslmode=require，用 STOCK_DB_OWNER_DSN / STOCK_DB_APP_DSN 整串覆盖。
STOCK_DB_HOST=REPLACE_ME_CLOUD_DB_HOST
STOCK_DB_PORT=5432
STOCK_DB_NAME=stock_analyze
# 三角色密码：必须 ≥32 字符随机值；生产守卫会拒绝 dev 默认值。
# 角色由 infra/postgres/init-prod/00-bootstrap.sh 在云主机上手工创建（幂等）。
STOCK_DB_OWNER_USER=stock_owner
STOCK_DB_OWNER_PASSWORD=REPLACE_ME_OWNER
STOCK_DB_APP_USER=stock_app
STOCK_DB_APP_PASSWORD=REPLACE_ME_APP
# stock_backup 角色密码只在云主机/备份侧管理，不注入应用容器
STOCK_DB_POOL_SIZE=10
STOCK_DB_MAX_OVERFLOW=10

# ── 认证 ──────────────────────────────────────────────────
# 必须替换：生产守卫拒绝 dev 默认值且要求 ≥32 字符
STOCK_JWT_SECRET=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARS
STOCK_ACCESS_TTL_SECONDS=900
STOCK_REFRESH_TTL_SECONDS=2592000

# ── 邮箱验证码 / 找回密码 ─────────────────────────────────
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=true
# aliyun 使用 RAM 角色/OIDC 默认凭据链，不写 AK
EMAIL_PROVIDER=aliyun
EMAIL_DM_ACCOUNT_NAME=REPLACE_ME_DM_ACCOUNT
EMAIL_BRAND=星星助手
EMAIL_SITE_HOST=xingst.site
EMAIL_DM_FROM_ALIAS=星星助手【xingst.site】
EMAIL_DM_ENDPOINT=dm.aliyuncs.com
EMAIL_DM_TIMEOUT_SECONDS=5
# 必须替换：生产守卫拒绝 dev 默认值且要求 ≥32 字符
EMAIL_CODE_PEPPER=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARS
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_IP_HOURLY_LIMIT=30
EMAIL_CODE_IP_DAILY_LIMIT=100
EMAIL_CODE_EMAIL_HOURLY_LIMIT=5
EMAIL_CODE_EMAIL_DAILY_LIMIT=10
# 只信任这些反代 peer 的转发头；必须覆盖 Docker 网段（web 内 nginx → api 的 peer）
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# ── 行情 / 板块 ───────────────────────────────────────────
MARKET_MODE=live
MARKET_LIVE_SOURCE=akshare
MARKET_LIVE_ADJUST=
MARKET_LIVE_TIMEOUT_SECONDS=10
MARKET_LIVE_CACHE_ENABLED=true
MARKET_LIVE_CACHE_READ_ONLY=true
MARKET_LIVE_MAX_CONCURRENCY=2
SECTOR_MODE=live
# 同花顺登录态：运行时注入，禁止写入仓库/日志
SECTOR_THS_COOKIE=
SECTOR_LOOKAHEAD_ENABLED=false

# ── 智能分析助手 ──────────────────────────────────────────
# 供应商/模型目录见 config/llm_providers.json（重启生效）；key 环境变量名在目录里声明。
# LLM_PROVIDER：auto（目录默认，glm-4-flash）/ none（关闭）/ 目录内供应商 id
LLM_PROVIDER=auto
GLM_API_KEY=
# 小米 MiMo：注入后即可在「设置 → 助手模型」选择 mimo-v2.6-* 模型
MIMO_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=2
CHAT_RPM=3
CHAT_DAILY_TURNS=50
CHAT_RETENTION_DAYS=180

# ── 运维 ──────────────────────────────────────────────────
STOCK_READYZ_TIMEOUT_SECONDS=2
