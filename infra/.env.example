# ── 运行环境 ───────────────────────────────────────────────
# local | prod
STOCK_ENV=local

# ── 数据库 ─────────────────────────────────────────────────
# 本地 compose（infra/compose/docker-compose.dev.yml，postgres:16）
STOCK_DB_HOST=127.0.0.1
STOCK_DB_PORT=5433
STOCK_DB_NAME=stock_analyze
# 迁移/DDL 使用 owner 角色；应用运行时使用非 owner 角色（无 BYPASSRLS）
STOCK_DB_OWNER_USER=stock_owner
STOCK_DB_OWNER_PASSWORD=stock_owner_pw
STOCK_DB_APP_USER=stock_app
STOCK_DB_APP_PASSWORD=stock_app_pw
# 允许直接覆盖（例如使用本机 Homebrew PostgreSQL 18）
# STOCK_DB_OWNER_DSN=postgresql+asyncpg://stock_owner:stock_owner_pw@127.0.0.1:5432/stock_analyze
# STOCK_DB_APP_DSN=postgresql+asyncpg://stock_app:stock_app_pw@127.0.0.1:5432/stock_analyze

# ── 认证 ───────────────────────────────────────────────────
# 生产必须通过密钥管理注入；本地默认值仅用于开发
STOCK_JWT_SECRET=dev-only-insecure-secret-change-me
STOCK_ACCESS_TTL_SECONDS=900
STOCK_REFRESH_TTL_SECONDS=2592000

# ── 外部依赖（一期一律走可替换实现）─────────────────────────
MARKET_MODE=replay
LLM_PROVIDER=none

# 行情 live 源（MARKET_MODE=live 时生效；需 `uv sync --extra live`，缺失则启动即失败）
MARKET_LIVE_SOURCE=akshare
# v1 仅接受不复权（空值）；qfq/hfq 被显式拒绝（ADR-0025：NAV 估值需真实市价）
MARKET_LIVE_ADJUST=
# akshare 请求超时（秒，传给上游 requests 的 connect/read 超时）
MARKET_LIVE_TIMEOUT_SECONDS=10
# 缓存开关：关闭则退化为纯 akshare（仅调试用）
MARKET_LIVE_CACHE_ENABLED=true
# 只读本地缓存（默认 true）：读路径绝不请求第三方；收盘后用 `make sync-market` 同步
# 设为 false 可恢复旧的 read-through（缺口/尾部即时拉取，仅调试用）
MARKET_LIVE_CACHE_READ_ONLY=true
# 正/负缓存 TTL（天）；负缓存用于「区间无行情」，短 TTL 避免把空结果永久固化
MARKET_LIVE_CACHE_TTL_DAYS=30
MARKET_LIVE_NEGATIVE_TTL_DAYS=1
# 旧 read-through 的尾部刷新窗口（自然日）：仅在 MARKET_LIVE_CACHE_READ_ONLY=false 时生效
MARKET_LIVE_TAIL_REFETCH_DAYS=5
# 上游并发上限（东财按并发封 IP，勿调大）
MARKET_LIVE_MAX_CONCURRENCY=2
# 重试：总尝试次数 + 指数退避基数（秒）
MARKET_LIVE_RETRY_ATTEMPTS=2
MARKET_LIVE_RETRY_BACKOFF_SECONDS=1.5

# ── 运维 ───────────────────────────────────────────────────
STOCK_LOG_LEVEL=INFO
STOCK_READYZ_TIMEOUT_SECONDS=2
